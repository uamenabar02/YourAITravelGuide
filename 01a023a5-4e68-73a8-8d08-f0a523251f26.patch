+/* ---------------------------------------------------------------------------
+   Animation utilities.
+   Several components use tailwindcss-animate-style class names (animate-in,
+   fade-in-20, slide-in-from-bottom-3, animate-fade-in, animate-slide-up).
+   That plugin is not installed, so we provide lightweight equivalents here
+   to keep the intended entrance animations working.
+--------------------------------------------------------------------------- */
+@keyframes le-overlay-in {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+@keyframes le-card-in {
+  from { opacity: 0; transform: translateY(10px) scale(0.99); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+@keyframes le-slide-up {
+  from { opacity: 0; transform: translateY(14px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+.animate-fade-in { animation: le-overlay-in 0.2s ease-out both; }
+.animate-slide-up { animation: le-slide-up 0.25s ease-out both; }
+.animate-in { animation: le-card-in 0.2s ease-out both; }
+.animate-in.fade-in-20,
+.animate-in.fade-in-50 { animation-name: le-overlay-in; }
+.animate-in.slide-in-from-bottom-3 { animation-name: le-slide-up; }
+
+@media (prefers-reduced-motion: reduce) {
+  .animate-fade-in,
+  .animate-slide-up,
+  .animate-in { animation: none; }
+}
+
 /* Warm organic scrollbar */
 ::-webkit-scrollbar {
   width: 6px;
