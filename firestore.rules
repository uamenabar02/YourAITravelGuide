rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper validation functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function emailDocId() {
      return "user_" + request.auth.token.email.replaceAll('[^a-z0-9]', '_');
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles Collection (Supports authenticated guests and registered users)
    match /users/{userId} {
      // User documents can be read by authenticated users (including anonymous guest sessions)
      allow read: if isValidId(userId) && request.auth != null;
      
      allow create, update: if isValidId(userId) 
        && request.auth != null
        && (
          userId == "guest_" + request.auth.uid ||
          userId == "user_" + request.auth.uid ||
          (request.auth.token.email != null && userId == emailDocId()) ||
          (request.resource.data.ownerUid != null && request.resource.data.ownerUid == request.auth.uid)
        );

      allow delete: if request.auth != null && (
        userId == "guest_" + request.auth.uid ||
        userId == "user_" + request.auth.uid ||
        (request.auth.token.email != null && userId == emailDocId()) ||
        (resource.data.ownerUid != null && resource.data.ownerUid == request.auth.uid)
      );
    }

    // 2. Shared Trips Collection (Real-time collaboration & community discovery)
    match /shared_trips/{tripId} {
      allow read: if isValidId(tripId);

      allow create: if isValidId(tripId)
        && request.auth != null
        && request.resource.data.plan is map
        && isNonEmptyString(request.resource.data.creatorEmail, 320);

      // Creator can update full trip; non-creators may only update interaction & collaboration fields
      allow update: if isValidId(tripId)
        && request.auth != null
        && (
          (resource.data.creatorUid is string && resource.data.creatorUid == request.auth.uid) ||
          (request.auth.token.email != null && resource.data.creatorEmail == request.auth.token.email) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reviews', 'rating', 'ratingsCount', 'downloadsCount', 'collabState', 'lastUpdated', 'updatedByEmail', 'offlineNotes', 'walletPasses'
          ])
        );

      allow delete: if request.auth != null && (
        (resource.data.creatorUid is string && resource.data.creatorUid == request.auth.uid) ||
        (request.auth.token.email != null && resource.data.creatorEmail == request.auth.token.email)
      );
    }

    // 3. Community Spots & Custom Activities Collection
    match /community_spots/{spotId} {
      allow read: if isValidId(spotId);

      allow create: if isValidId(spotId)
        && request.auth != null
        && isNonEmptyString(request.resource.data.name, 300);

      // Creator can update full spot; non-creators may only update community interaction fields
      allow update: if isValidId(spotId)
        && request.auth != null
        && (
          (resource.data.creatorUid is string && resource.data.creatorUid == request.auth.uid) ||
          (request.auth.token.email != null && resource.data.creatorEmail == request.auth.token.email) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reviews', 'likedBy', 'likesCount', 'ratingsCount', 'rating'
          ])
        );

      allow delete: if request.auth != null && (
        (resource.data.creatorUid is string && resource.data.creatorUid == request.auth.uid) ||
        (request.auth.token.email != null && resource.data.creatorEmail == request.auth.token.email)
      );
    }
  }
}
