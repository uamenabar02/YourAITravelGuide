rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper validation functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      
      allow create: if isValidId(userId) 
        && request.resource.data.email is string
        && (
          userId.startsWith("guest_") ||
          userId.startsWith("user_")
        );

      allow update: if isValidId(userId)
        && request.resource.data.email is string
        && (
          userId.startsWith("guest_") ||
          (
            userId.startsWith("user_") &&
            (request.auth == null || request.auth.token.email == null || userId == "user_" + request.auth.token.email.replace('[^a-z0-9]', '_'))
          )
        );

      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && userId == "user_" + request.auth.token.email.replace('[^a-z0-9]', '_'))
      );
    }

    // 2. Shared Trips Collection (Real-time collaboration & community discovery)
    match /shared_trips/{tripId} {
      allow read: if isValidId(tripId);

      allow create: if isValidId(tripId)
        && request.resource.data.plan is map
        && request.resource.data.creatorEmail is string;

      allow update: if isValidId(tripId)
        && request.resource.data.plan is map;

      allow delete: if request.auth != null && (
        (resource.data.creatorEmail is string && request.auth.token.email != null && resource.data.creatorEmail == request.auth.token.email) ||
        (resource.data.creatorUid is string && resource.data.creatorUid == request.auth.uid)
      );
    }

    // 3. Community Spots & Custom Activities Collection
    match /community_spots/{spotId} {
      allow read: if isValidId(spotId);

      allow create, update: if isValidId(spotId)
        && isNonEmptyString(request.resource.data.name, 300);

      allow delete: if request.auth != null;
    }
  }
}
