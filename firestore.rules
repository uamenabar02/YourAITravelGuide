rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Shared Trips Collection
    match /shared_trips/{tripId} {
      allow read, write: if true;
    }

    // 3. Community Spots & Activities Collection
    match /community_spots/{spotId} {
      allow read, write: if true;
    }
  }
}
